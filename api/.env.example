# Copy to api/.env and fill in real values. Never commit api/.env or real keys.
# api/.env is git-ignored; this file must contain placeholders only.

# ============================================================================
# Token Plan — designated competition provider (OpenAI-compatible chat only).
# The dedicated key MUST be used with the dedicated base URL below. Requests to
# the general dashscope.aliyuncs.com endpoint do NOT consume Token Plan quota.
# ============================================================================
TOKEN_PLAN_API_KEY=
TOKEN_PLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Listing-draft model and agent-chat model. Any Token Plan text model is valid;
# default qwen3.7-plus (fast "plus" tier; avoids the slower reason-by-default
# qwen3.6 variants).
TOKEN_PLAN_TEXT_MODEL=qwen3.7-plus
TOKEN_PLAN_AGENT_MODEL=qwen3.7-plus
# Read timeout (s) for one chat call. On timeout the request falls back to the
# local drafts so the demo keeps working.
TOKEN_PLAN_TIMEOUT_S=60
TOKEN_PLAN_CONNECT_TIMEOUT_S=10

# Optional gateway tier, tried before Token Plan when set.
LISTING_UPSTREAM_URL=http://127.0.0.1:8000
LISTING_UPSTREAM_USER=listing-demo

# Legacy generic OpenAI-compatible overrides. Still honoured for backward
# compatibility; prefer TOKEN_PLAN_* above. Used as the chat key / base / model
# only when the matching TOKEN_PLAN_* variable is unset.
# LISTING_LLM_BASE_URL=
# LISTING_LLM_API_KEY=
# LISTING_LLM_MODEL=

# ----------------------------------------------------------------------------
# Image / video generation. NOT part of the Token Plan integration yet (their
# Token Plan API protocols are unverified). Unchanged from before.
# ----------------------------------------------------------------------------
# 生图走 OpenAI 兼容 /images/generations，结果用 data URL，不传公司 R2
# LISTING_IMAGE_BASE_URL=https://work.poloapi.com/v1
# LISTING_IMAGE_MODEL=gpt-image-2-c
# LISTING_IMAGE_API_KEY=
# LISTING_VIDEO_BASE_URL=https://work.poloapi.com/v1
# LISTING_VIDEO_MODEL=sora-2
# LISTING_VIDEO_API_KEY=

# ----------------------------------------------------------------------------
# CORS: the frontend defaults to same-origin /api (no CORS needed). Only if the
# SPA is built with VITE_LISTING_API pointing at a DIFFERENT origin must the API
# allow that origin — set it in api/app.py's CORSMiddleware (allow_origins).
# See docs/DEPLOY.md section 3a.
