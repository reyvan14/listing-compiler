# Copy to api/.env and fill in real values. Never commit api/.env or real keys.
# api/.env is git-ignored; this file must contain placeholders only.

# ============================================================================
# Token Plan — designated competition provider (OpenAI-compatible chat only).
# The dedicated key MUST be used with the dedicated base URL below. Requests to
# the general dashscope.aliyuncs.com endpoint do NOT consume Token Plan quota.
# ============================================================================
# TOKEN_PLAN_API_KEY is also the fallback key for image and video generation
# (see the Image / video section below) when no dedicated media key is set. In
# production it is injected by systemd EnvironmentFile, never committed here.
TOKEN_PLAN_API_KEY=
TOKEN_PLAN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Listing-draft model and agent-chat model. Any Token Plan text model is valid;
# default qwen3.7-plus (fast "plus" tier; avoids the slower reason-by-default
# qwen3.6 variants).
TOKEN_PLAN_TEXT_MODEL=qwen3.7-plus
TOKEN_PLAN_AGENT_MODEL=qwen3.7-plus
# Read timeout (s) for one chat call. On timeout the request falls back to the
# local drafts so the demo keeps working.
TOKEN_PLAN_TIMEOUT_S=60
TOKEN_PLAN_CONNECT_TIMEOUT_S=10

# Optional gateway tier, tried before Token Plan when set.
LISTING_UPSTREAM_URL=http://127.0.0.1:8000
LISTING_UPSTREAM_USER=listing-demo

# Legacy generic OpenAI-compatible overrides. Still honoured for backward
# compatibility; prefer TOKEN_PLAN_* above. Used as the chat key / base / model
# only when the matching TOKEN_PLAN_* variable is unset.
# LISTING_LLM_BASE_URL=
# LISTING_LLM_API_KEY=
# LISTING_LLM_MODEL=

# ----------------------------------------------------------------------------
# Image / video generation. Two protocols are supported and both stay reachable:
#
#   legacy      - OpenAI-compatible POST /images/generations and PoloAPI-style
#                 POST /videos (the historical providers; still the default).
#   token_plan  - Token Plan native DashScope-style endpoints on the dedicated
#                 host token-plan.cn-beijing.maas.aliyuncs.com:
#                   image : POST /api/v1/services/aigc/multimodal-generation/generation
#                   video : POST /api/v1/services/aigc/video-generation/video-synthesis
#                           (async: header X-DashScope-Async: enable), then poll
#                           GET  /api/v1/tasks/{task_id} until task_status is
#                           SUCCEEDED (-> output.video_url) or FAILED.
#
# Protocol choice per media kind:
#   1. LISTING_IMAGE_PROVIDER / LISTING_VIDEO_PROVIDER = token_plan | legacy wins.
#   2. else auto-detected as token_plan when the matching *_BASE_URL is on the
#      token-plan.* host.
#   3. else legacy.
# The API key for either kind falls back to TOKEN_PLAN_API_KEY when no
# LISTING_IMAGE_API_KEY / LISTING_VIDEO_API_KEY (or GPT_IMAGE_2_API_KEY) is set.
# Results are always returned as data URLs / provider CDN URLs; company R2 / OSS
# URLs are dropped.
# ----------------------------------------------------------------------------
# LISTING_IMAGE_PROVIDER=legacy
# LISTING_VIDEO_PROVIDER=legacy

# --- legacy provider knobs ---
# LISTING_IMAGE_BASE_URL=https://work.poloapi.com/v1
# LISTING_IMAGE_MODEL=gpt-image-2-c
# LISTING_IMAGE_API_KEY=
# LISTING_VIDEO_BASE_URL=https://work.poloapi.com/v1
# LISTING_VIDEO_MODEL=sora-2
# LISTING_VIDEO_API_KEY=

# --- token_plan provider knobs ---
# To use Token Plan media, set the provider (or point *_BASE_URL at the
# token-plan host) and leave the model unset to get the documented defaults
# (image: qwen-image-2.0, video: happyhorse-1.1-t2v).
# LISTING_IMAGE_PROVIDER=token_plan
# LISTING_VIDEO_PROVIDER=token_plan
# LISTING_IMAGE_MODEL=qwen-image-2.0
# LISTING_VIDEO_MODEL=happyhorse-1.1-t2v
# Optional origin override for the Token Plan media host (defaults to
# https://token-plan.cn-beijing.maas.aliyuncs.com).
# TOKEN_PLAN_MEDIA_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com
# Video is async: poll interval and overall timeout (seconds). Lower the timeout
# in tests; production defaults are 15 and 600.
# LISTING_VIDEO_POLL_INTERVAL_S=15
# LISTING_VIDEO_POLL_TIMEOUT_S=600
# Optional fixed output resolution (e.g. 720P / 1080P); otherwise derived from
# the requested aspect ratio.
# LISTING_VIDEO_RESOLUTION=720P

# ----------------------------------------------------------------------------
# CORS: the frontend defaults to same-origin /api (no CORS needed). Only if the
# SPA is built with VITE_LISTING_API pointing at a DIFFERENT origin must the API
# allow that origin — set it in api/app.py's CORSMiddleware (allow_origins).
# See docs/DEPLOY.md section 3a.
